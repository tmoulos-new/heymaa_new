{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/main.py": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    {
      "source": "/admin",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(insights|quality|testers|invite-codes|gifts|regions|levels|plans|points|content|sources|users|user-data|user-activity|tools|activity-log|chat-prompt|llm-transactions|user-financials|cancellations|support|notifications|emails)",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!auth(?:/|$)|profile(?:/|$)|chat(?:/|$)|tts(?:/|$)|offers(?:/|$)|support(?:/|$)|public/offers|public/promotions|public/places_map|public/babyspace-rss|userdata(?:/|$)|user_activity(?:/|$)|gamification(?:/|$)|webhooks(?:/|$)|checkout/viva(?:/|$)|healthz$|functions(?:/|$)|admin(?:/|$)|me(?:/|$)|static/).*)",
      "destination": "/index.html"
    }
  ]
}
