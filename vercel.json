{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/main.py": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    {
      "source": "/admin/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!auth(?:/|$)|profile(?:/|$)|chat$|tts$|offers$|public/offers|public/promotions|userdata$|user_activity$|gamification(?:/|$)|webhooks(?:/|$)|checkout/viva$|healthz$|functions(?:/|$)|admin/(?:health|me|usage|insights|chat-quality|credits|llm_transactions|upload|offers|promotions|regions|levels|plans|point_rules|point_settings|rag_sources|invite_codes|profiles|users|user_data|user_activity|chat_prompt|llm_routing|activity_log|invite_tester|subscription-cancellations)(?:/|$)|static/).*)",
      "destination": "/index.html"
    }
  ]
}
