{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/main.py": {
      "maxDuration": 120,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,frontend/public/**,frontend/build/**,frontend/scripts/**,admin/node_modules/**,admin/src/**,admin/public/**,Cloudflare Demo/**,Clouflare Heymaa/**,.cursor/**,docs/**,scripts/**,dist/**,static/**,.venv/**,backend/.venv/**,backend/__pycache__/**,backend/migrations/**,backend/knowledge_seed/**,backend/milestones_cache/**,backend/scripts/**,**/*.md,**/*.test.py,**/test_*.py,uv.lock,.git/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    {
      "source": "/admin/:path*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/html.*" }],
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!auth(?:/|$)|profile(?:/|$)|chat$|tts$|offers$|public/offers|public/promotions|userdata$|user_activity$|gamification(?:/|$)|webhooks(?:/|$)|checkout/viva$|healthz$|functions(?:/|$)|admin/(?:health|me|usage|insights|chat-quality|credits|llm_transactions|upload|offers|promotions|regions|levels|plans|point_rules|point_settings|rag_sources|invite_codes|profiles|users|user_data|user_activity|chat_prompt|activity_log|invite_tester|subscription-cancellations)(?:/|$)|static/).*)",
      "destination": "/index.html"
    }
  ]
}
